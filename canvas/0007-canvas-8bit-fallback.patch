+/// Matrix (R209, Surface Duo): msm_drm/SDE on the Android 4.14 kernel lists 10-bit formats on the
+/// primary plane but rejects an XRGB2101010 framebuffer in the atomic test commit (EINVAL), and
+/// smithay gives up after the first format. Last resort: 8-bit formats only.
+const COLOR_FORMATS_8BIT: [Fourcc; 4] = [
+    Fourcc::Xrgb8888,
+    Fourcc::Xbgr8888,
+    Fourcc::Argb8888,
+    Fourcc::Abgr8888,
+];
