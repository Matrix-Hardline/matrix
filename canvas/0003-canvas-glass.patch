+        }
+    } else {
+        y0 = glass_inset_y;
+        y1 = geo_size.y - glass_inset_y;
+    }
+    vec2 center = vec2(geo_size.x * 0.5, (y0 + y1) * 0.5);
+    vec2 half_size = vec2(geo_size.x * 0.5 - glass_inset_x, (y1 - y0) * 0.5);
+    vec2 q = p - center;
+    float r;
+    if (q.x < 0.0) {
+        r = (q.y < 0.0) ? corner_radius.x : corner_radius.w;
+    } else {
+        r = (q.y < 0.0) ? corner_radius.y : corner_radius.z;
+    }
+    vec2 a = abs(q) - half_size + vec2(r);
+    float d = length(max(a, 0.0)) + min(max(a.x, a.y), 0.0) - r;
+    // Murano union: fold the neighbors in via smooth minimum — the
+    // field is ONE poured form, so rim, refraction and shadow follow
+    // a merged silhouette wherever two panels come close.
+    if (glass_union > 0.0) {
+        for (int i = 0; i < GLASS_BODIES; i++) {
+            d = glass_union_sdf(d, p, glass_body[i], glass_body_radius[i]);
+        }
+    }
+    return d;
+}
+
+vec2 glass_sample_coords(vec2 p) {
+    vec3 back = geo_to_input * vec3(p / geo_size, 1.0);
+    return back.xy;
+}
+
+vec3 glass_saturate(vec3 color, float sat) {
+    const vec3 w = vec3(0.2126, 0.7152, 0.0722);
+    return mix(vec3(dot(color, w)), color, sat);
+}
+
+void main() {
+    vec3 coords_geo = input_to_geo * vec3(v_coords, 1.0);
+    vec2 p = coords_geo.xy * geo_size;
+
+    float d = glass_sdf(p);
+
+    // SDF gradient by central differences — the refraction normal.
+    float e = 1.0;
+    vec2 grad = vec2(
+        glass_sdf(p + vec2(e, 0.0)) - glass_sdf(p - vec2(e, 0.0)),
+        glass_sdf(p + vec2(0.0, e)) - glass_sdf(p - vec2(0.0, e)));
+    grad = normalize(grad + vec2(1e-5));
+
+    // Rim band: 0 deep inside, 1 at the edge (d is negative inside).
+    // Calibration (user finding, red wallpaper 2026-07-22): the first
+    // proportional band (35% of the pill) smeared bright content deep
+    // into the body. macOS keeps the lens a thin constant ring. Both
+    // knobs come from the layer rule and are live-tunable there.
+    float rim = clamp(1.0 + d / glass_band, 0.0, 1.0);
+    rim = rim * rim;
+
+    float bend = glass_bend * rim;
+
+    // Chromatic fringe: three samples, per-channel bend scales.
+    vec4 cr = texture2D(tex, glass_sample_coords(p - grad * bend * 1.15));
+    vec4 cg = texture2D(tex, glass_sample_coords(p - grad * bend));
+    vec4 cb = texture2D(tex, glass_sample_coords(p - grad * bend * 0.85));
+    vec4 color = vec4(cr.r, cg.g, cb.b, 1.0);
+
+    if (saturation != 1.0) {
+        color.rgb = glass_saturate(color.rgb, saturation);
+    }
+
+    // Legibility limiter (macOS limitAveragePixelLuminance, in-pass):
+    // the glass measures its own frosted brightness and darkens
+    // proportionally, so light panel text keeps contrast on bright
+    // backdrops. Zero effect on dark scenes.
+    if (glass_scrim > 0.0) {
+        float lum = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
+        float over = smoothstep(0.55, 0.95, lum);
+        color.rgb *= 1.0 - over * glass_scrim;
+    }
+
+    // R174g: the reference lights its glass along an AXIS, not from a
+    // corner. On macOS 27 and iPadOS the bright rim runs across the
+    // TOP AND THE BOTTOM edge while the left and right flanks stay
+    // dark (user, comparing both systems side by side). A directional
+    // key light cannot do that — it lights two ADJACENT edges, which
+    // is exactly what we had: left and top.
+    //
+    // So the term reads the gradient's vertical share instead of a
+    // light vector. The top keeps the stronger rim (the light still
+    // comes from above), the bottom catches the softer bounce, and
+    // the flanks get the shade.
+    float up = -grad.y;
+    float horizon = abs(up);
+    float flank = abs(grad.x);
+    float rim_edge = pow(rim, 3.0);
+    float lit = horizon * mix(0.72, 1.0, step(0.0, up));
+    color.rgb += rim_edge * lit * 0.22;
+    color.rgb -= rim_edge * flank * 0.08;
+
+    // Fine grain keeps the frost from banding (macOS noise floor).
+    if (noise > 0.0) {
+        color.rgb += (glass_hash12(gl_FragCoord.xy) - 0.5) * noise;
+    }
+
+    // Outside the pill body the glass vanishes; in its place the DROP
+    // SHADOW rises from the SAME distance field (shape family phase A):
+    // a gaussian of the distance, offset downward like the key light
+    // demands. One shape, one truth — an abrupt shadow edge is
+    // structurally impossible, and the app paints no ring of its own.
+    float coverage = 1.0 - smoothstep(-1.0, 1.0, d);
+    color = color * coverage;
+
+    if (glass_shadow > 0.0) {
+        float ds = glass_sdf(p - vec2(0.0, 4.0));
+        float sigma = max(glass_shadow_spread, 1.0);
+        float fall = exp(-(max(ds, 0.0) * max(ds, 0.0)) / (2.0 * sigma * sigma));
+        // The surface rectangle would amputate the gaussian (user
+        // finding: dark wedges at the bar ends, boxy halo around the
+        // dock). Fade to ZERO toward every surface edge, so however
+        // little room a side reserves, the tail always lands softly.
+        float d_edge = min(min(p.x, geo_size.x - p.x), min(p.y, geo_size.y - p.y));
+        float edge_fade = smoothstep(0.0, 10.0, d_edge);
+        float shadow_a = glass_shadow * fall * edge_fade * (1.0 - coverage);
+        // Premultiplied black: alpha only, the body keeps its color.
+        color.a = min(color.a + shadow_a, 1.0);
+    }
+
+    if (coords_geo.x < 0.0 || 1.0 < coords_geo.x || coords_geo.y < 0.0 || 1.0 < coords_geo.y) {
+        // Clip outside geometry.
+        color = vec4(0.0);
+    } else {
+        // Apply corner rounding inside geometry.
+        color = color * niri_rounding_alpha(coords_geo.xy * geo_size, geo_size, corner_radius);
+    }
+
+    color = color * alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    // Matrix R128: appearance fade — the glass must not show
+    // before the client painted content (premultiplied output).
+    gl_FragColor = color * glass_fade;
+}
