         map_props(&dev.fd, &planes, &mut mapping.planes)?;
+        for plane in planes.iter() {
+            let alpha = mapping.planes.get(plane).and_then(|props| props.get("alpha")).copied();
+            if let Some(info) = alpha.and_then(|prop| dev.fd.get_property(prop).ok()) {
+                if let property::ValueType::UnsignedRange(_, max) = info.value_type() {
+                    mapping.plane_alpha_max.insert(*plane, max);
+                }
+            }
+        }
 
         dev.old_state = old_state;
