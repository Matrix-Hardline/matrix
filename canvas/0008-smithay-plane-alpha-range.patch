+    /// Upper end of each plane's `alpha` range (Matrix R209, see `plane_alpha_max`).
+    pub plane_alpha_max: HashMap<plane::Handle, u64>,
 }
 
 impl PropMapping {
+    /// Matrix (R209): full opacity in the plane's own `alpha` range. The DRM convention is 16 bit
+    /// (0..=0xffff), but msm_drm/SDE on the Android 4.14 kernel (Surface Duo) exposes 0..=255 and
+    /// rejects 0xffff with EINVAL -- every atomic test commit failed and no output came up.
+    pub(crate) fn plane_alpha_max(&self, handle: plane::Handle) -> u64 {
+        self.plane_alpha_max.get(&handle).copied().unwrap_or(0xffff)
+    }
