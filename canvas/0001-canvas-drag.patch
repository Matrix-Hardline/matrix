diff --git a/src/canvas.rs b/src/canvas.rs
new file mode 100644
index 0000000..2d1e68d
--- /dev/null
+++ b/src/canvas.rs
@@ -0,0 +1,142 @@
+//! Matrix canvas — the module home of the fork identity (R46).
+//!
+//! Decoupling step 2 (patch→modules): everything the canvas adds to
+//! upstream lives in its own files — here the empty-space rule and
+//! the window-ghost render hook; the input gestures sit in
+//! input/canvas.rs, the camera methods in layout/
+//! floating_canvas.rs. Upstream files keep only hook-in lines.
+
+use smithay::backend::renderer::element::Kind;
+use smithay::output::Output;
+use smithay::utils::{Logical, Point};
+
+use crate::niri::{Niri, PointContents};
+use crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement;
+use crate::render_helpers::renderer::NiriRenderer;
+use crate::render_helpers::texture::TextureRenderElement;
+
+/// The empty-space rule of the canvas: no window, no hot corner, at
+/// most the WALLPAPER level (background layer) under the pointer —
+/// there gestures belong to the canvas, not to the apps.
+/// R199: bottom-layer surfaces are interactive citizens — the Raum
+/// scrim lives there, and wheel/finger in the gap between two bodies
+/// belongs to the Raum, not to canvas paging (finding: scrolling
+/// stopped whenever the pointer crossed a gap).
+pub fn empty_space(under: &PointContents) -> bool {
+    under.window.is_none()
+        && !under.hot_corner
+        && under.layer.as_ref().map_or(true, |l| {
+            matches!(
+                l.layer(),
+                smithay::wayland::shell::wlr_layer::Layer::Background
+            )
+        })
+}
+
+impl Niri {
+    /// Window ghost of the canvas: if the mouse rests on empty space,
+    /// the icon cloud of the open apps springs in next to it. Returns
+    /// the finished render element; None = nothing to show.
+    pub fn canvas_ghost_element<R: NiriRenderer>(
+        &self,
+        output: &Output,
+        renderer: &mut R,
+    ) -> Option<PrimaryGpuTextureRenderElement> {
+    // Matrix canvas: the window ghost — if the mouse rests on empty
+    // space, the icon cloud of the open apps springs in next to it
+    // (spatially like on the canvas; view center = larger icon).
+        if !self.config.borrow().gestures.canvas_drag {
+            return None;
+        }
+        let pointer = self.seat.get_pointer()?;
+        let ort = pointer.current_location();
+        let out_geo = self.global_space.output_geometry(output)?;
+        // The ghost lives only on the output under the pointer — only
+        // there may the visibility target be adjusted.
+        if !out_geo.to_f64().contains(ort) {
+            return None;
+        }
+
+        let mut window: Vec<(String, Point<f64, Logical>, bool)> = Vec::new();
+        let mut goal = self.pointer_visibility.is_visible()
+            && !self.layout.is_overview_open();
+        if goal {
+            let under = self.contents_under(ort);
+            goal = under.window.is_none()
+                && !under.hot_corner
+                && under.layer.as_ref().map_or(true, |l| {
+                    matches!(
+                        l.layer(),
+                        smithay::wayland::shell::wlr_layer::Layer::Background
+                            | smithay::wayland::shell::wlr_layer::Layer::Bottom
+                    )
+                });
+        }
+        if goal {
+            if let Some(mon) = self.layout.monitor_for_output(output) {
+                let info = mon.active_workspace_ref().canvas_ghost_info();
+                window = info
+                    .iter()
+                    .map(|(win, z, active)| {
+                        let app_id = win
+                            .toplevel()
+                            .and_then(|t| {
+                                crate::utils::with_toplevel_role(t, |role| {
+                                    role.app_id.clone()
+                                })
+                            })
+                            .unwrap_or_default();
+                        (app_id, *z, *active)
+                    })
+                    .collect();
+            }
+            goal = !window.is_empty();
+        }
+
+        // Ghost mode (user 2026-07-07): by default only visible after
+        // wheel paging — then it fades away again.
+        let goal = self.window_ghost.goal_show(goal) && goal;
+        self.window_ghost.set_target(goal);
+        let alpha = self.window_ghost.alpha();
+        if alpha <= 0.004 {
+            return None;
+        }
+
+        let scale = output.current_scale().fractional_scale();
+        let (buffer, position) = if goal {
+            let buffer = self.window_ghost.render(renderer, scale, &window)?;
+            // Next to the pointer, clamped into the screen (scroll-ghost
+            // grammar: right, flipping left at the edge).
+            let size = buffer.logical_size();
+            let local = ort - out_geo.loc.to_f64();
+            let out_size = out_geo.size.to_f64();
+            let mut x = local.x + 26.0;
+            let mut y = local.y + 26.0;
+            if x + size.w > out_size.w - 8.0 {
+                x = local.x - size.w - 26.0;
+            }
+            if y + size.h > out_size.h - 8.0 {
+                y = (out_size.h - size.h - 8.0).max(8.0);
+            }
+            self.window_ghost.note_down_ort(x, y);
+            (buffer, (x, y))
+        } else {
+            // Fading out: the last cloud fades in place.
+            let buffer = self.window_ghost.last_texture()?;
+            (buffer, self.window_ghost.last_ort())
+        };
+
+        let location = Point::from(position)
+            .to_physical_precise_round(scale)
+            .to_logical(scale);
+        let elem = TextureRenderElement::from_texture_buffer(
+            buffer,
+            location,
+            alpha as f32,
+            None,
+            None,
+            Kind::Unspecified,
+        );
+        Some(PrimaryGpuTextureRenderElement(elem))
+    }
+}
diff --git a/src/input/canvas.rs b/src/input/canvas.rs
new file mode 100644
index 0000000..2f6b908
--- /dev/null
+++ b/src/input/canvas.rs
@@ -0,0 +1,280 @@
+//! Matrix canvas — the empty-space gestures (R46: lifted out of
+//! input/mod.rs). Mouse drag (2D pan), click-fetches, right-click menu,
+//! wheel/finger paging with sticky buffer, one-finger touch swipe.
+//! Kind-Modul from input — sieht dessen private Helfer.
+
+use smithay::backend::input::{AxisSource, MouseButton, TouchSlot};
+use smithay::input::pointer::{CursorIcon, CursorImageStatus, Focus, GrabStartData as PointerGrabStartData};
+use smithay::utils::{Logical, Point, Serial};
+
+use super::modifiers_from_state;
+use super::spatial_movement_grab::SpatialMovementGrab;
+use crate::canvas::empty_space;
+use crate::niri::{PointContents, State};
+
+/// Focus from outside (dock click, window ghost): the camera drives to
+/// the window — the same ride as the canvas click (task #33).
+pub fn focus_camera(state: &mut State, window: &smithay::desktop::Window) {
+    if state.niri.config.borrow().gestures.canvas_drag
+        && crate::utils::matrix_switch_on("canvas-klick-holt")
+        && state.niri.layout.canvas_window_show(window)
+    {
+        // FIXME: granular.
+        state.niri.queue_redraw_all();
+    }
+}
+
+/// Left-dragging on EMPTY SPACE pans the view in all directions —
+/// the desktop as an infinite canvas. true = grab set, event
+/// consumed. Activation: gestures { canvas-drag } in the config (legacy: leinwand-drag).
+pub fn drag_start(
+    state: &mut State,
+    button: Option<MouseButton>,
+    button_code: u32,
+    serial: Serial,
+    is_overview_open: bool,
+) -> bool {
+    if button != Some(MouseButton::Left) {
+        return false;
+    }
+    let pointer = state.niri.seat.get_pointer().unwrap();
+    if pointer.is_grabbed()
+        || is_overview_open
+        || !state.niri.config.borrow().gestures.canvas_drag
+    {
+        return false;
+    }
+    let location = pointer.current_location();
+    let under = state.niri.contents_under(location);
+    if !empty_space(&under) {
+        return false;
+    }
+    let output_ws = state.niri.output_under_cursor().and_then(|output| {
+        let mon = state.niri.layout.monitor_for_output(&output)?;
+        Some((output, mon.active_workspace_ref().id()))
+    });
+    let Some((output, ws_id)) = output_ws else {
+        return false;
+    };
+    state.niri.layout.focus_output(&output);
+    let start_data = PointerGrabStartData {
+        focus: None,
+        button: button_code,
+        location,
+    };
+    let grab = SpatialMovementGrab::new_canvas(start_data, output, ws_id);
+    pointer.set_grab(state, grab, serial, Focus::Clear);
+    state
+        .niri
+        .cursor_manager
+        .set_cursor_image(CursorImageStatus::Named(CursorIcon::AllScroll));
+    state.niri.queue_redraw_all();
+    true
+}
+
+/// Clicking a CLIPPED window drives it fully into view — fully
+/// visible windows stay calm so work clicks never yank the camera.
+///
+pub fn click_fetch(state: &mut State, is_overview_open: bool, mod_down: bool) {
+    let pointer = state.niri.seat.get_pointer().unwrap();
+    if is_overview_open
+        || mod_down
+        || pointer.is_grabbed()
+        || !state.niri.config.borrow().gestures.canvas_drag
+        || !crate::utils::matrix_switch_on("canvas-klick-holt")
+    {
+        return;
+    }
+    let window = state.niri.window_under_cursor().map(|m| m.window.clone());
+    if let Some(win) = window {
+        if state.niri.layout.canvas_window_show(&win) {
+            // FIXME: granular.
+            state.niri.queue_redraw_all();
+        }
+    }
+}
+
+/// Right click on EMPTY SPACE opens the desktop context menu
+/// (matrix-context) — the compositor only supplies place and occasion.
+/// Bar surfaces (dock/bar) do not count as empty space (finding 2026-07-08).
+pub fn right_click_context(
+    state: &mut State,
+    button: Option<MouseButton>,
+    is_overview_open: bool,
+    mod_down: bool,
+) {
+    let pointer = state.niri.seat.get_pointer().unwrap();
+    if button != Some(MouseButton::Right)
+        || is_overview_open
+        || mod_down
+        || pointer.is_grabbed()
+        || !state.niri.config.borrow().gestures.canvas_drag
+        || state.niri.window_under_cursor().is_some()
+    {
+        return;
+    }
+    let pos = pointer.current_location();
+    let on_panel = state.niri.output_under(pos).is_some_and(|(output, pos_in_out)| {
+        use smithay::wayland::shell::wlr_layer::Layer as WlrLayer;
+        let layers = smithay::desktop::layer_map_for_output(output);
+        [WlrLayer::Overlay, WlrLayer::Top, WlrLayer::Bottom]
+            .iter()
+            .any(|l| {
+                layers.layers_on(*l).any(|ls| {
+                    layers
+                        .layer_geometry(ls)
+                        .is_some_and(|g| g.to_f64().contains(pos_in_out))
+                })
+            })
+    });
+    if on_panel {
+        return;
+    }
+    crate::utils::spawning::spawn(
+        vec![
+            "sh".to_string(),
+            "-c".to_string(),
+            format!(
+                "PATH=$HOME/.local/bin:/usr/bin:$PATH exec matrix-context canvas {} {}",
+                pos.x as i32, pos.y as i32
+            ),
+        ],
+        None,
+    );
+}
+
+/// MOUSE WHEEL OR TRACKPAD on EMPTY SPACE pages through the windows —
+/// with a sticky buffer (1 s from the last tick, 24 px stillness).
+/// true = the event belongs to the canvas.
+pub fn wheel_paging(
+    state: &mut State,
+    source: AxisSource,
+    vertical_amount_v120: Option<f64>,
+    vertical_px: f64,
+    is_overview_open: bool,
+    is_mru_open: bool,
+) -> bool {
+    if !(source == AxisSource::Wheel || source == AxisSource::Finger)
+        || is_overview_open
+        || is_mru_open
+        || !state.niri.config.borrow().gestures.canvas_drag
+    {
+        return false;
+    }
+    let pointer = state.niri.seat.get_pointer().unwrap();
+    if pointer.is_grabbed() {
+        return false;
+    }
+    let mods = state.niri.seat.get_keyboard().unwrap().modifier_state();
+    if !modifiers_from_state(mods).is_empty() {
+        return false;
+    }
+    let location = pointer.current_location();
+    let under = state.niri.contents_under(location);
+    // Sticky buffer: after paging the camera centers — a window can
+    // slide under the STANDING mouse. As long as the pointer stands
+    // (almost) still and the last paging tick is less than a second
+    // old, the wheel keeps belonging to the canvas; every tick
+    // refreshes the deadline. (User flow finding, 2026-07-13.)
+    let sticky = state.niri.canvas_paging_last.is_some_and(|(time, ort)| {
+        time.elapsed().as_millis() < 1000 && {
+            let d = location - ort;
+            d.x * d.x + d.y * d.y <= 24.0 * 24.0
+        }
+    });
+    if !(empty_space(&under) || sticky) {
+        return false;
+    }
+    let ticks = if source == AxisSource::Wheel {
+        let vertical = vertical_amount_v120.unwrap_or(0.);
+        state.niri.vertical_wheel_tracker.accumulate(vertical)
+    } else {
+        state.niri.canvas_finger_roll += vertical_px;
+        let steps = (state.niri.canvas_finger_roll / 60.0).trunc() as i8;
+        if steps != 0 {
+            state.niri.canvas_finger_roll -= f64::from(steps) * 60.0;
+        }
+        steps
+    };
+    if ticks != 0 && crate::utils::matrix_switch_on("canvas-paging") {
+        let direction = if ticks > 0 { 1 } else { -1 };
+        for _ in 0..ticks.abs() {
+            if let Some(id) = state.niri.layout.canvas_paging(direction) {
+                state.niri.layout.activate_window(&id);
+            }
+        }
+        // The window ghost shows itself for paging.
+        state.niri.window_ghost.activate();
+        // Refresh the sticky deadline: 1 s from the LAST tick.
+        state.niri.canvas_paging_last =
+            Some((std::time::Instant::now(), location));
+        // FIXME: granular.
+        state.niri.queue_redraw_all();
+    }
+    true
+}
+
+/// A ONE-FINGER SWIPE on empty canvas space starts touch paging —
+/// the app below never sees a down. true = swipe taken over.
+pub fn swipe_start(
+    state: &mut State,
+    slot: TouchSlot,
+    pos: Point<f64, Logical>,
+    under: &PointContents,
+    mods_empty: bool,
+) -> bool {
+    let Some(handle) = state.niri.seat.get_touch() else {
+        return false;
+    };
+    if !state.niri.config.borrow().gestures.canvas_drag
+        || handle.is_grabbed()
+        || state.niri.canvas_swipe.is_some()
+        || state.niri.screenshot_ui.is_open()
+        || state.niri.window_mru_ui.is_open()
+        || state.niri.layout.is_overview_open()
+        || !mods_empty
+        || !empty_space(under)
+    {
+        return false;
+    }
+    state.niri.canvas_swipe = Some((slot, pos.y, 0.0));
+    true
+}
+
+/// Swipe end: pass nothing to the app. true = consumed.
+pub fn swipe_end(state: &mut State, slot: TouchSlot) -> bool {
+    if state.niri.canvas_swipe.is_some_and(|(wslot, ..)| wslot == slot) {
+        state.niri.canvas_swipe = None;
+        return true;
+    }
+    false
+}
+
+/// Running swipe: one paging step per 90 px. Finger UP = forward
+/// (phone logic). true = the motion belongs to the canvas.
+pub fn swipe_step(state: &mut State, slot: TouchSlot, pos: Point<f64, Logical>) -> bool {
+    let Some((wslot, last_y, collector)) = state.niri.canvas_swipe else {
+        return false;
+    };
+    if wslot != slot {
+        return false;
+    }
+    const THRESHOLD: f64 = 90.0;
+    let mut collector = collector + (pos.y - last_y);
+    let steps = (collector / THRESHOLD).trunc() as i32;
+    if steps != 0 {
+        collector -= f64::from(steps) * THRESHOLD;
+        if crate::utils::matrix_switch_on("canvas-paging") {
+            let direction = if steps > 0 { -1 } else { 1 };
+            for _ in 0..steps.unsigned_abs() {
+                if let Some(id) = state.niri.layout.canvas_paging(direction) {
+                    state.niri.layout.activate_window(&id);
+                }
+            }
+            state.niri.window_ghost.activate();
+            state.niri.queue_redraw_all();
+        }
+    }
+    state.niri.canvas_swipe = Some((wslot, pos.y, collector));
+    true
+}
