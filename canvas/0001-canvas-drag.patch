+/// Matrix-Einstellungs-Kultur (~/.config/matrix/<name>): kleine, lesbare
+/// Files — the canvas reads them LIVE, changes act immediately.
+pub fn matrix_setting(name: &str) -> Option<String> {
+    let home = std::env::var("HOME").ok()?;
+    std::fs::read_to_string(format!("{home}/.config/matrix/{name}"))
+        .ok()
+        .map(|s| s.trim().to_string())
+}
+
+/// Switch convention: missing file = ON; only "aus" switches off.
+pub fn matrix_switch_on(name: &str) -> bool {
+    matrix_setting(name).as_deref() != Some("aus")
+}
