+//! The window ghost (Matrix original, 2026-07-07).
+//!
+//! On the infinite canvas there is no overview of the open windows —
+//! the window ghost shows it: if the mouse rests on empty space, a
+//! small icon cloud of all open apps fades in next to it, arranged
+//! spatially like the windows on the canvas (a miniature map of app
+//! icons). The window of the view center is simply LARGER than the
+//! others and carries a same-shaped squircle edge.
+//! Related to the scroll ghost of the MatrixKit apps: orientation
+//! appears at the mouse, not at the edge — and springs in and out.
+//!
+//! GEISTKIT RULE: the ghosts belong to MatrixKit and obey its laws —
+//! colors come from the living DMS palette (light and dark), the
+//! radii are concentric, the font is Inter, and "reduce motion"
+//! (~/.config/matrix/motion) switches the spring off.
+//! Nothing that keeps the system alive is hardcoded.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+use std::path::PathBuf;
+use std::rc::Rc;
+
+use niri_config::Config;
+use pangocairo::cairo::{self, Format, ImageSurface};
+use pangocairo::pango::{self, FontDescription};
+use smithay::backend::renderer::gles::{GlesRenderer, GlesTexture};
+use smithay::utils::{Logical, Point, Transform};
+
+use crate::animation::{Animation, Clock};
+use crate::render_helpers::renderer::NiriRenderer;
+use crate::render_helpers::texture::TextureBuffer;
+
+/// Logical size of an icon in the cloud.
+const ICON: f64 = 24.0;
+/// The window of the view center: simply larger instead of ringed.
+const ACTIVE: f64 = 34.0;
+/// Maximum extent of the center cluster (without padding).
+/// Window ghost 3.0 (user design): no map projection anymore —
+/// a calm LIST, at most three icons stacked, the active one in
+/// the middle. Paging shifts the row with wraparound.
+const LIST_MAX: usize = 3;
+const LIST_CADENCE: f64 = ACTIVE + 10.0;
+const PADDING: f64 = 12.0;
+/// Mindestabstand zweier Icon-Zentren (Entzerrung naher Fenster).
+
+/// Squircle radius of the icon tiles — the same curve as the
+/// MatrixKit app icons (~28 % of the edge length).
+fn corner(gr: f64) -> f64 {
+    gr * 0.28
+}
+
+/// The living MatrixKit palette, as far as the ghost needs it
+/// (GeistKit rule: no hardcoded colors).
+struct GhostPalette {
+    panel: (f64, f64, f64),
+    edge: (f64, f64, f64),
+    active: (f64, f64, f64),
+    tile: (f64, f64, f64),
+    tile_text: (f64, f64, f64),
+}
+
+impl Default for GhostPalette {
+    /// Fallback = the Matrix defaults (dark) — only if the DMS
+    /// palette does not exist (yet).
+    fn default() -> Self {
+        Self {
+            panel: hex_rgb("#2b2b22").unwrap(),
+            edge: hex_rgb("#e4e3d7").unwrap(),
+            active: hex_rgb("#bece7f").unwrap(),
+            tile: hex_rgb("#3f4c0a").unwrap(),
+            tile_text: hex_rgb("#daeb99").unwrap(),
+        }
+    }
+}
+
+fn hex_rgb(hex: &str) -> Option<(f64, f64, f64)> {
+    let h = hex.trim().trim_start_matches('#');
+    if h.len() < 6 {
+        return None;
+    }
+    let part = |a: usize| u8::from_str_radix(&h[a..a + 2], 16).ok();
+    Some((
+        f64::from(part(0)?) / 255.0,
+        f64::from(part(2)?) / 255.0,
+        f64::from(part(4)?) / 255.0,
+    ))
+}
+
+fn dms_colors_path() -> Option<PathBuf> {
+    let home = std::env::var("HOME").ok()?;
+    Some(PathBuf::from(home).join(".cache/DankMaterialShell/dms-colors.json"))
+}
+
+/// Read the palette from the DMS color file — roles like
+/// mk::Palette::load() in matrixkit-theme, light/dark from the DMS session.
+fn load_palette() -> GhostPalette {
+    let d = GhostPalette::default();
+    let Some(path) = dms_colors_path() else { return d };
+    let Ok(raw) = std::fs::read_to_string(path) else { return d };
+    let Ok(json) = serde_json::from_str::<serde_json::Value>(&raw) else { return d };
+    let light = std::env::var("HOME")
+        .ok()
+        .and_then(|h| {
+            std::fs::read_to_string(format!("{h}/.local/state/DankMaterialShell/session.json"))
+                .ok()
+        })
+        .and_then(|s| serde_json::from_str::<serde_json::Value>(&s).ok())
+        .and_then(|v| v.get("isLightMode").and_then(|b| b.as_bool()))
+        .unwrap_or(false);
+    let mode = &json["colors"][if light { "light" } else { "dark" }];
+    let role = |name: &str, fallback: (f64, f64, f64)| {
+        mode
+            .get(name)
+            .and_then(|v| v.as_str())
+            .and_then(hex_rgb)
+            .unwrap_or(fallback)
+    };
+    GhostPalette {
+        panel: role("surface_container_high", d.panel),
+        edge: role("on_surface", d.edge),
+        active: role("primary", d.active),
+        tile: role("primary_container", d.tile),
+        tile_text: role("on_primary_container", d.tile_text),
+    }
+}
+
+/// MatrixKit accessibility: reduce motion applies to ghosts too.
+fn motion_reduced() -> bool {
+    std::env::var("HOME")
+        .ok()
+        .and_then(|h| std::fs::read_to_string(format!("{h}/.config/matrix/motion")).ok())
+        .map(|s| s.trim() == "reduced")
+        .unwrap_or(false)
+}
+
+/// Change stamp of the color file — goes into the texture hash so a
+/// wallpaper/mode switch recolors the cloud immediately.
+fn palette_stamp() -> u64 {
+    dms_colors_path()
+        .and_then(|p| std::fs::metadata(p).ok())
+        .and_then(|m| m.modified().ok())
+        .and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok())
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// Fade in and out like the scroll ghost: soft spring, no jumping.
+enum Phase {
+    Hidden,
+    Appearing(Animation),
+    Shown,
+    Vanishing(Animation),
+}
+
+/// When does the ghost show itself? (~/.config/matrix/canvas-ghost)
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum GhostMode {
+    /// Only after wheel paging — appears, helps, fades (default).
+    OnScroll,
+    /// Always while the mouse rests on empty space.
+    Always,
+    Off,
+}
+
+pub struct WindowGhost {
+    clock: Clock,
+    config: Rc<RefCell<Config>>,
+    phase: RefCell<Phase>,
+    /// app_id → dekodiertes Icon (None = Fallback-Kachel merken).
+    icons: RefCell<HashMap<String, Option<ImageSurface>>>,
+    /// Zuletzt gerenderte Wolke: (Layout-Hash, Textur).
+    buffer: RefCell<Option<(u64, TextureBuffer<GlesTexture>)>>,
+    /// Last display place (fading out happens in place).
+    last_ort: Cell<(f64, f64)>,
+    /// Last wheel paging — in scroll mode the ghost lives 1.6 s.
+    last_active: Cell<Option<std::time::Instant>>,
+    /// Mode cache (file re-read every 2 s).
+    mode_cache: Cell<Option<(std::time::Instant, GhostMode)>>,
+}
+
+impl WindowGhost {
+    pub fn new(clock: Clock, config: Rc<RefCell<Config>>) -> Self {
+        Self {
+            clock,
+            config,
+            phase: RefCell::new(Phase::Hidden),
+            icons: RefCell::new(HashMap::new()),
+            buffer: RefCell::new(None),
+            last_ort: Cell::new((0.0, 0.0)),
+            last_active: Cell::new(None),
+            mode_cache: Cell::new(None),
+        }
+    }
+
+    /// Wheel paging reports in — the ghost shows itself (scroll mode).
+    pub fn activate(&self) {
+        self.last_active.set(Some(std::time::Instant::now()));
+    }
+
+    fn mode(&self) -> GhostMode {
+        if let Some((when, m)) = self.mode_cache.get() {
+            if when.elapsed().as_secs() < 2 {
+                return m;
+            }
+        }
+        let m = match crate::utils::matrix_setting("canvas-ghost").as_deref() {
+            Some("always") | Some("immer") => GhostMode::Always,
+            Some("off") | Some("aus") => GhostMode::Off,
+            _ => GhostMode::OnScroll,
+        };
+        self.mode_cache.set(Some((std::time::Instant::now(), m)));
+        m
+    }
+
+    /// Shall the ghost be visible? (empty_space = mouse on free canvas)
+    pub fn goal_show(&self, empty_space: bool) -> bool {
+        match self.mode() {
+            GhostMode::Off => false,
+            GhostMode::Always => empty_space,
+            GhostMode::OnScroll => {
+                empty_space
+                    && self
+                        .last_active
+                        .get()
+                        .is_some_and(|t| t.elapsed().as_millis() < 1600)
+            }
+        }
+    }
+
+    fn animation(&self, from: f64, to: f64) -> Animation {
+        let c = self.config.borrow();
+        Animation::new(
+            self.clock.clone(),
+            from,
+            to,
+            0.,
+            c.animations.config_notification_open_close.0,
+        )
+    }
+
+    /// Set the target visibility — a change starts the spring.
+    /// (RefCell because the decision falls in the render path.)
+    pub fn set_target(&self, visible: bool) {
+        let mut phase = self.phase.borrow_mut();
+        // MatrixKit rule: reduced motion = instant, no spring.
+        if motion_reduced() {
+            *phase = if visible { Phase::Shown } else { Phase::Hidden };
+            return;
+        }
+        match (&*phase, visible) {
+            (Phase::Hidden | Phase::Vanishing(_), true) => {
+                let from = match &*phase {
+                    Phase::Vanishing(anim) => anim.value().clamp(0.0, 1.0),
+                    _ => 0.0,
+                };
+                *phase = Phase::Appearing(self.animation(from, 1.0));
+            }
+            (Phase::Shown | Phase::Appearing(_), false) => {
+                let from = match &*phase {
+                    Phase::Appearing(anim) => anim.value().clamp(0.0, 1.0),
+                    _ => 1.0,
+                };
+                *phase = Phase::Vanishing(self.animation(from, 0.0));
+            }
+            _ => (),
+        }
+    }
+
+    /// Resolve finished transitions (from Niri::advance_animations).
+    pub fn advance_animations(&self) {
+        let mut phase = self.phase.borrow_mut();
+        match &*phase {
+            Phase::Appearing(anim) if anim.is_done() => *phase = Phase::Shown,
+            Phase::Vanishing(anim) if anim.is_clamped_done() => *phase = Phase::Hidden,
+            _ => (),
+        }
+    }
+
+    pub fn are_animations_ongoing(&self) -> bool {
+        matches!(
+            &*self.phase.borrow(),
+            Phase::Appearing(_) | Phase::Vanishing(_)
+        )
+    }
+
+    /// Current opacity of the spring.
+    pub fn alpha(&self) -> f64 {
+        match &*self.phase.borrow() {
+            Phase::Hidden => 0.0,
+            Phase::Shown => 1.0,
+            Phase::Appearing(anim) | Phase::Vanishing(anim) => anim.value().clamp(0.0, 1.0),
+        }
+    }
+
+    pub fn note_down_ort(&self, x: f64, y: f64) {
+        self.last_ort.set((x, y));
+    }
+
+    pub fn last_ort(&self) -> (f64, f64) {
+        self.last_ort.get()
+    }
+
+    /// The last drawn cloud (for fading out in place).
+    pub fn last_texture(&self) -> Option<TextureBuffer<GlesTexture>> {
+        self.buffer.borrow().as_ref().map(|(_, b)| b.clone())
+    }
+
+    /// The icon cloud as a texture — cached as long as window set,
+    /// arrangement and view center do not change.
+    pub fn render<R: NiriRenderer>(
+        &self,
+        renderer: &mut R,
+        scale: f64,
+        window: &[(String, Point<f64, Logical>, bool)],
+    ) -> Option<TextureBuffer<GlesTexture>> {
+        if window.is_empty() {
+            return None;
+        }
+
+        // 1) Paging order: like the mouse wheel — left to right.
+        let mut row: Vec<usize> = (0..window.len()).collect();
+        row.sort_by(|&a, &b| {
+            window[a]
+                .1
+                .x
+                .partial_cmp(&window[b].1.x)
+                .unwrap_or(std::cmp::Ordering::Equal)
+                .then(
+                    window[a]
+                        .1
+                        .y
+                        .partial_cmp(&window[b].1.y)
+                        .unwrap_or(std::cmp::Ordering::Equal),
+                )
+        });
+
+        // 2) The excerpt: at most THREE stacked — the active one in
+        //    the middle, the predecessor above, the successor below
+        //    (with wraparound, like the paging itself).
+        let active_pos = row.iter().position(|&i| window[i].2).unwrap_or(0);
+        let n = row.len();
+        let selection: Vec<usize> = if n <= LIST_MAX {
+            row
+        } else {
+            vec![
+                row[(active_pos + n - 1) % n],
+                row[active_pos],
+                row[(active_pos + 1) % n],
+            ]
+        };
+        let list: Vec<(String, Point<f64, Logical>, bool)> =
+            selection.iter().map(|&i| window[i].clone()).collect();
+
+        // 3) Column places: centers at a fixed pace, one column.
+        let edge = PADDING + ACTIVE / 2.0;
+        let width = 2.0 * edge;
+        let height = (list.len().saturating_sub(1)) as f64 * LIST_CADENCE + 2.0 * edge;
+        let slots: Vec<(f64, f64, bool)> = list
+            .iter()
+            .enumerate()
+            .map(|(k, (_, _, active))| (edge, edge + k as f64 * LIST_CADENCE, *active))
+            .collect();
+
+        // Cache key: apps + rasterized places + view center + scale.
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        for ((app, _, _), (x, y, active)) in list.iter().zip(&slots) {
+            app.hash(&mut h);
+            (((*x / 3.0) as i64), ((*y / 3.0) as i64), *active).hash(&mut h);
+        }
+        scale.to_bits().hash(&mut h);
+        palette_stamp().hash(&mut h);
+        let key = h.finish();
+
+        if let Some((k, buf)) = &*self.buffer.borrow() {
+            if *k == key {
+                return Some(buf.clone());
+            }
+        }
+
+        let buf = self
+            .draw_all(
+                renderer.as_gles_renderer(),
+                scale,
+                width,
+                height,
+                &list,
+                &slots,
+            )
+            .ok()?;
+        *self.buffer.borrow_mut() = Some((key, buf.clone()));
+        Some(buf)
+    }
+
+    fn draw_all(
+        &self,
+        renderer: &mut GlesRenderer,
+        scale: f64,
+        width: f64,
+        height: f64,
+        window: &[(String, Point<f64, Logical>, bool)],
+        slots: &[(f64, f64, bool)],
+    ) -> anyhow::Result<TextureBuffer<GlesTexture>> {
+        let b_phys = (width * scale).round() as i32;
+        let h_phys = (height * scale).round() as i32;
+        let surface = ImageSurface::create(Format::ARgb32, b_phys, h_phys)?;
+        let cr = cairo::Context::new(&surface)?;
+        cr.scale(scale, scale);
+
+        // GeistKit: the living palette — follows wallpaper and light/dark.
+        let p = load_palette();
+
+        // Panel: slightly translucent surface with a fine edge.
+        // Radius CONCENTRIC to the icon squircles (mk::radius rule:
+        // outer = inner + inset).
+        let panel_radius = corner(ICON) + PADDING;
+        rounded_rect(&cr, 0.5, 0.5, width - 1.0, height - 1.0, panel_radius);
+        cr.set_source_rgba(p.panel.0, p.panel.1, p.panel.2, 0.92);
+        cr.fill_preserve()?;
+        cr.set_source_rgba(p.edge.0, p.edge.1, p.edge.2, 0.12);
+        cr.set_line_width(1.0);
+        cr.stroke()?;
+
+        let mut icons = self.icons.borrow_mut();
+        // Draw the active icon last — it visibly lies on top.
+        let mut ordering: Vec<usize> = (0..slots.len()).collect();
+        ordering.sort_by_key(|&i| slots[i].2);
+        for i in ordering {
+            let (app_id, _, _) = &window[i];
+            let (x, y, active) = slots[i];
+            let icon = icons
+                .entry(app_id.clone())
+                .or_insert_with(|| load_icon(app_id));
+
+            let gr = if active { ACTIVE } else { ICON };
+            let ox = x - gr / 2.0;
+            let oy = y - gr / 2.0;
+            // Endless-wheel feel (user design): top and bottom fade the
+            // neighbors out, only the view center stands fully.
+            let fade = if active { 1.0 } else { 0.45 };
+
+            // Uniform squircle shape for ALL icons (consistency — foreign
+            // icons get the MatrixKit curve too).
+            cr.save()?;
+            cr.push_group();
+            rounded_rect(&cr, ox, oy, gr, gr, corner(gr));
+            cr.clip();
+            match icon {
+                Some(img) => {
+                    let iw = img.width() as f64;
+                    let ih = img.height() as f64;
+                    cr.translate(ox, oy);
+                    cr.scale(gr / iw, gr / ih);
+                    cr.set_source_surface(img, 0.0, 0.0)?;
+                    cr.paint()?;
+                }
+                None => {
+                    // Fallback: tinted tile with the initial letter
+                    // (primary_container / on_primary_container).
+                    cr.set_source_rgba(p.tile.0, p.tile.1, p.tile.2, 1.0);
+                    cr.paint()?;
+                    let letter = app_id
+                        .rsplit(['.', '-'])
+                        .next()
+                        .and_then(|t| t.chars().next())
+                        .unwrap_or('?')
+                        .to_uppercase()
+                        .to_string();
+                    let layout = pangocairo::functions::create_layout(&cr);
+                    let mut font = FontDescription::from_string("Inter Variable Bold 12");
+                    font.set_absolute_size(gr * 0.55 * f64::from(pango::SCALE));
+                    layout.set_font_description(Some(&font));
+                    layout.set_text(&letter);
+                    let (tw, th) = layout.pixel_size();
+                    cr.move_to(
+                        ox + (gr - f64::from(tw)) / 2.0,
+                        oy + (gr - f64::from(th)) / 2.0,
+                    );
+                    cr.set_source_rgba(p.tile_text.0, p.tile_text.1, p.tile_text.2, 1.0);
+                    pangocairo::functions::show_layout(&cr, &layout);
+                }
+            }
+            cr.pop_group_to_source()?;
+            cr.paint_with_alpha(fade)?;
+            cr.restore()?;
+
+            // View center: larger icon + same-shaped squircle edge
+            // (NO circle — the edge follows the icon shape, concentrically).
+            if active {
+                let air = 2.5;
+                rounded_rect(
+                    &cr,
+                    ox - air,
+                    oy - air,
+                    gr + 2.0 * air,
+                    gr + 2.0 * air,
+                    corner(gr) + air,
+                );
+                cr.set_source_rgba(p.active.0, p.active.1, p.active.2, 0.95);
+                cr.set_line_width(2.0);
+                cr.stroke()?;
+            }
+        }
+        drop(cr);
+
+        let data = surface.take_data().unwrap();
+        let buffer = TextureBuffer::from_memory(
+            renderer,
+            &data,
+            smithay::backend::allocator::Fourcc::Argb8888,
+            (b_phys, h_phys),
+            false,
+            scale,
+            Transform::Normal,
+            Vec::new(),
+        )?;
+        Ok(buffer)
+    }
+}
+
+fn rounded_rect(cr: &cairo::Context, x: f64, y: f64, b: f64, h: f64, r: f64) {
+    let r = r.min(b / 2.0).min(h / 2.0);
+    cr.new_path();
+    cr.arc(x + b - r, y + r, r, -std::f64::consts::FRAC_PI_2, 0.0);
+    cr.arc(x + b - r, y + h - r, r, 0.0, std::f64::consts::FRAC_PI_2);
+    cr.arc(
+        x + r,
+        y + h - r,
+        r,
+        std::f64::consts::FRAC_PI_2,
+        std::f64::consts::PI,
+    );
+    cr.arc(
+        x + r,
+        y + r,
+        r,
+        std::f64::consts::PI,
+        1.5 * std::f64::consts::PI,
+    );
+    cr.close_path();
+}
+
+/// App icon as a cairo surface: PNG from the hicolor themes, turned
+/// into premultiplied ARgb32. None = no icon found.
+fn load_icon(app_id: &str) -> Option<ImageSurface> {
+    if app_id.is_empty() {
+        return None;
+    }
+    let path = icon_path(app_id)?;
+    let file = std::io::BufReader::new(std::fs::File::open(path).ok()?);
+    let mut reader = png::Decoder::new(file).read_info().ok()?;
+    let mut buf = vec![0u8; reader.output_buffer_size()?];
+    let info = reader.next_frame(&mut buf).ok()?;
+    if info.bit_depth != png::BitDepth::Eight {
+        return None;
+    }
+    let (w, h) = (info.width as usize, info.height as usize);
+    let stride = Format::ARgb32.stride_for_width(w as u32).ok()? as usize;
+    let mut data = vec![0u8; stride * h];
+    let channels = match info.color_type {
+        png::ColorType::Rgba => 4,
+        png::ColorType::Rgb => 3,
+        _ => return None,
+    };
+    for line in 0..h {
+        for column in 0..w {
+            let q = (line * w + column) * channels;
+            let (r, g, b, a) = if channels == 4 {
+                (buf[q], buf[q + 1], buf[q + 2], buf[q + 3])
+            } else {
+                (buf[q], buf[q + 1], buf[q + 2], 255)
+            };
+            // Premultiply (cairo ARgb32) + native-endian Pixelwort.
+            let m = |k: u8| ((k as u32 * a as u32) / 255) as u32;
+            let px: u32 = ((a as u32) << 24) | (m(r) << 16) | (m(g) << 8) | m(b);
+            let z = line * stride + column * 4;
+            data[z..z + 4].copy_from_slice(&px.to_ne_bytes());
+        }
+    }
+    ImageSurface::create_for_data(data, Format::ARgb32, w as i32, h as i32, stride as i32).ok()
+}
+
+fn icon_path(app_id: &str) -> Option<PathBuf> {
+    let mut roots: Vec<String> = Vec::new();
+    if let Ok(h) = std::env::var("HOME") {
+        roots.push(format!("{h}/.local/share/icons"));
+    }
+    roots.push("/usr/share/icons".to_string());
+    roots.push("/var/lib/flatpak/exports/share/icons".to_string());
+    for wurzel in &roots {
+        for size in ["128x128", "64x64", "256x256", "48x48", "512x512"] {
+            let p = PathBuf::from(format!("{wurzel}/hicolor/{size}/apps/{app_id}.png"));
+            if p.exists() {
+                return Some(p);
+            }
+        }
+    }
+    None
+}
