index 0000000..f93c9f7
--- /dev/null
+++ b/src/layout/floating_canvas.rs
@@ -0,0 +1,255 @@
+//! Matrix canvas — camera (peek), paging, homeward, ghost info,
+//! spawn order and de-overlap of the FloatingSpace (R46: lifted out
+//! of floating.rs; child module, sees the private fields).
+
+use super::*;
+
+impl<W: LayoutElement> FloatingSpace<W> {
+    /// Leinwand-Modus aktiv? (Config: gestures { canvas-drag })
+    pub(super) fn canvas(&self) -> bool {
+        self.options.gestures.canvas_drag
+    }
+
+    /// Move the camera: the plane follows the cursor (grab the paper).
+    pub fn canvas_pan(&mut self, delta: Point<f64, Logical>) {
+        if self.canvas() {
+            self.view -= delta;
+        }
+    }
+
+    /// Homeward: set the camera so the centroid of all windows sits
+    /// centered in the workspace — against getting lost on the infinite
+    /// plane. (The call springs via tiles_with_render_positions.)
+    pub fn canvas_homeward(&mut self) {
+        if !self.canvas() || self.data.is_empty() {
+            return;
+        }
+        let mut center = Point::from((0.0, 0.0));
+        for d in &self.data {
+            center += d.logical_pos + d.size.downscale(2.0).to_point();
+        }
+        let n = self.data.len() as f64;
+        center = Point::from((center.x / n, center.y / n));
+        let target = self.working_area.loc + self.working_area.size.downscale(2.0).to_point();
+        self.view = center - target;
+    }
+
+    /// Fenster-Geist (Matrix-Original, 7.7.): Zentren aller Leinwand-
+    /// Windows + marker of the window closest to the view center —
+    /// the basis of the icon cloud next to the mouse.
+    pub fn canvas_ghost_info(&self) -> Vec<(W::Id, Point<f64, Logical>, bool)> {
+        if !self.canvas() || self.data.is_empty() {
+            return Vec::new();
+        }
+        let view_center =
+            self.working_area.loc + self.working_area.size.downscale(2.0).to_point() + self.view;
+        let centers: Vec<Point<f64, Logical>> = self
+            .data
+            .iter()
+            .map(|d| d.logical_pos + d.size.downscale(2.0).to_point())
+            .collect();
+        let next_pt = (0..centers.len()).min_by(|&a, &b| {
+            let da = centers[a] - view_center;
+            let db = centers[b] - view_center;
+            (da.x * da.x + da.y * da.y).total_cmp(&(db.x * db.x + db.y * db.y))
+        });
+        self.tiles
+            .iter()
+            .zip(centers)
+            .enumerate()
+            .map(|(i, (tile, z))| (tile.window().id().clone(), z, Some(i) == next_pt))
+            .collect()
+    }
+
+    /// Canvas paging (user idea 2026-07-07): the mouse wheel on empty
+    /// space wanders through the windows — spatially sorted (left→right,
+    /// ties top→bottom). The camera centers the chosen window (making it
+    /// fully visible), the ride springs like a magic move.
+    /// Returns the window that shall receive focus.
+    pub fn canvas_paging(&mut self, direction: i32) -> Option<W::Id> {
+        if !self.canvas() || self.data.is_empty() {
+            return None;
+        }
+        let centers: Vec<Point<f64, Logical>> = self
+            .data
+            .iter()
+            .map(|d| d.logical_pos + d.size.downscale(2.0).to_point())
+            .collect();
+        let mut ordering: Vec<usize> = (0..centers.len()).collect();
+        ordering.sort_by(|&a, &b| {
+            centers[a]
+                .x
+                .total_cmp(&centers[b].x)
+                .then(centers[a].y.total_cmp(&centers[b].y))
+        });
+        // "Current" = the window whose center is closest to the view
+        // center — what the eye currently takes for front.
+        let view_center =
+            self.working_area.loc + self.working_area.size.downscale(2.0).to_point() + self.view;
+        let next_one = (0..centers.len()).min_by(|&a, &b| {
+            let da = centers[a] - view_center;
+            let db = centers[b] - view_center;
+            (da.x * da.x + da.y * da.y).total_cmp(&(db.x * db.x + db.y * db.y))
+        })?;
+        let pos = ordering.iter().position(|&i| i == next_one)? as i64;
+        let n = ordering.len() as i64;
+        let target = ordering[(pos + direction as i64).rem_euclid(n) as usize];
+
+        // Center the camera on the target — fully visible as long as the
+        // window fits the screen; the tiles spring over from the old view.
+        let alt = self.view;
+        self.view = centers[target]
+            - (self.working_area.loc + self.working_area.size.downscale(2.0).to_point());
+        let diff = self.view - alt;
+        if diff.x * diff.x + diff.y * diff.y > 4.0 {
+            for tile in &mut self.tiles {
+                tile.animate_move_from(diff);
+            }
+        }
+        Some(self.tiles[target].window().id().clone())
+    }
+
+    /// Window click on the canvas (user idea 2026-07-07): a NOT fully
+    /// visible window drives fully into view when clicked — like wheel
+    /// paging. Fully visible windows stay calm so work clicks (buttons,
+    /// text) never yank the camera.
+    /// Returns true if the camera moved.
+    pub fn canvas_window_show(&mut self, id: &W::Id) -> bool {
+        if !self.canvas() {
+            return false;
+        }
+        let Some(i) = self.tiles.iter().position(|t| t.window().id() == id) else {
+            return false;
+        };
+        let window = Rectangle::new(self.data[i].logical_pos, self.data[i].size);
+        let view = Rectangle::new(self.working_area.loc + self.view, self.working_area.size);
+        // Tolerance: 2px of rounding air still counts as "fully visible".
+        let air = 2.0;
+        let inside = window.loc.x >= view.loc.x - air
+            && window.loc.y >= view.loc.y - air
+            && window.loc.x + window.size.w <= view.loc.x + view.size.w + air
+            && window.loc.y + window.size.h <= view.loc.y + view.size.h + air;
+        if inside {
+            return false;
+        }
+        let alt = self.view;
+        let center_pt = window.loc + window.size.downscale(2.0).to_point();
+        self.view =
+            center_pt - (self.working_area.loc + self.working_area.size.downscale(2.0).to_point());
+        let diff = self.view - alt;
+        if diff.x * diff.x + diff.y * diff.y > 4.0 {
+            for tile in &mut self.tiles {
+                tile.animate_move_from(diff);
+            }
+        }
+        true
+    }
+
+    /// Canvas spawn: a free spot near the current view — windows open
+    /// SIDE BY SIDE, never overlapping (ring search around the center).
+    pub(super) fn canvas_spawn_pos(&self, size: Size<f64, Logical>) -> Point<f64, Logical> {
+        let basis = center_preferring_top_left_in_area(self.working_area, size) + self.view;
+        let free = |p: Point<f64, Logical>| {
+            let candidate = Rectangle::new(p, size);
+            !self
+                .data
+                .iter()
+                .any(|d| candidate.overlaps(Rectangle::new(d.logical_pos, d.size)))
+        };
+        if free(basis) {
+            return basis;
+        }
+        let step = 64.0;
+        for ring in 1..=16 {
+            let r = ring as f64 * step;
+            for (dx, dy) in [
+                (r, 0.0), (-r, 0.0), (0.0, r), (0.0, -r),
+                (r, r), (-r, r), (r, -r), (-r, -r),
+            ] {
+                let p = basis + Point::from((dx, dy));
+                if free(p) {
+                    return p;
+                }
+            }
+        }
+        basis
+    }
+
+    /// Canvas rule: windows NEVER overlap. The originator (e.g. the
+    /// enlarged or dropped window) stays put — overlapped neighbors yield
+    /// along the smallest separation axis, cascading, until calm reigns
+    /// (user feedback 2026-07-07: "windows do not get used to the new
+    /// size").
+    pub(super) fn canvas_deoverlap(&mut self, fest: usize) {
+        if !self.canvas() || self.data.len() < 2 {
+            return;
+        }
+        const AIR: f64 = 16.0;
+        for _ in 0..64 {
+            let mut moved = false;
+            for i in 0..self.data.len() {
+                for j in 0..self.data.len() {
+                    if i == j || j == fest {
+                        continue;
+                    }
+                    // For non-originator pairs check only one direction,
+                    // else i and j push each other endlessly.
+                    if i != fest && i > j {
+                        continue;
+                    }
+                    let a = Rectangle::new(self.data[i].logical_pos, self.data[i].size);
+                    let b = Rectangle::new(self.data[j].logical_pos, self.data[j].size);
+                    if !a.overlaps(b) {
+                        continue;
+                    }
+                    // R57 (user finding): if a window lies COMPLETELY inside the
+                    // other, that is INTENDED (Matrix Web's docking coupling lays
+                    // the WebKit carrier congruently under the chrome). Such pairs
+                    // are left alone by the de-overlap — otherwise coupling and
+                    // order fight endlessly (that was the glitching of the white
+                    // window).
+                    let encloses = |outer: Rectangle<f64, Logical>,
+                                       inner: Rectangle<f64, Logical>| {
+                        let air = 4.0;
+                        inner.loc.x >= outer.loc.x - air
+                            && inner.loc.y >= outer.loc.y - air
+                            && inner.loc.x + inner.size.w
+                                <= outer.loc.x + outer.size.w + air
+                            && inner.loc.y + inner.size.h
+                                <= outer.loc.y + outer.size.h + air
+                    };
+                    if encloses(a, b) || encloses(b, a) {
+                        continue;
+                    }
+                    // Smallest separation axis: j yields to i.
+                    let after_right = a.loc.x + a.size.w - b.loc.x + AIR;
+                    let leftward = b.loc.x + b.size.w - a.loc.x + AIR;
+                    let after_bottom = a.loc.y + a.size.h - b.loc.y + AIR;
+                    let after_top = b.loc.y + b.size.h - a.loc.y + AIR;
+                    let min = after_right.min(leftward).min(after_bottom).min(after_top);
+                    let offset = if min == after_right {
+                        Point::from((after_right, 0.0))
+                    } else if min == leftward {
+                        Point::from((-leftward, 0.0))
+                    } else if min == after_bottom {
+                        Point::from((0.0, after_bottom))
+                    } else {
+                        Point::from((0.0, -after_top))
+                    };
+                    let before = self.data[j].logical_pos;
+                    let fresh = before + offset;
+                    self.data[j].set_logical_pos(fresh);
+                    // Springy yielding (magic move) instead of jumping.
+                    let diff = before - self.data[j].logical_pos;
+                    if diff.x * diff.x + diff.y * diff.y > 4.0 {
+                        self.tiles[j].animate_move_from(diff);
+                    }
+                    moved = true;
+                }
+            }
+            if !moved {
+                break;
+            }
+        }
+    }
+}
