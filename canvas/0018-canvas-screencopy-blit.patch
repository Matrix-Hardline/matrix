+    /// Matrix (0018): take the frame copies waiting for `output`.
+    pub fn take_frame_copies(&mut self, output: &Output) -> Vec<Screencopy> {
+        let (mine, rest): (Vec<_>, Vec<_>) = std::mem::take(&mut self.frame_copies)
+            .into_iter()
+            .partition(|(_, s)| s.output() == output);
+        self.frame_copies = rest;
+        mine.into_iter().map(|(_, s)| s).collect()
+    }
+
+    /// Matrix (0018): queue a frame copy; should its output not draw within
+    /// 500 ms (a dark panel, a stalled output), it is dropped — the client
+    /// hears «failed» and falls back instead of waiting forever.
+    pub fn queue_frame_copy(&mut self, screencopy: Screencopy) {
+        use smithay::reexports::calloop::timer::{TimeoutAction, Timer};
+        let output = screencopy.output().clone();
+        self.frame_copy_serial += 1;
+        let serial = self.frame_copy_serial;
+        self.frame_copies.push((serial, screencopy));
+        self.queue_redraw(&output);
+        let timer = Timer::from_duration(Duration::from_millis(500));
+        let _ = self.event_loop.insert_source(timer, move |_, _, state| {
+            if let Some(i) = state.niri.frame_copies.iter().position(|(s, _)| *s == serial) {
+                warn!("screencopy: output did not draw in time, copy dropped");
+                drop(state.niri.frame_copies.remove(i));
+            }
+            TimeoutAction::Drop
+        });
+    }
+
