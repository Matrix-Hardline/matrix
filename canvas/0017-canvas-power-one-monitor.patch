+    /// Matrix: power off one output (by name). Its CRTC goes inactive like
+    /// for `deactivate_monitors`, and it is not drawn until powered on.
+    pub fn deactivate_monitor(&mut self, backend: &mut Backend, name: &str) {
+        if !self.output_state.keys().any(|o| o.name() == name) {
+            warn!("power-off-monitor: no output {name}");
+            return;
+        }
+        if self.dark_outputs.insert(name.to_string()) {
+            info!("power-off-monitor: {name} dark");
+            backend.set_output_active(name, false);
+        }
+    }
+
+    /// Matrix: power that output on again. On the Duo the panels must wake in
+    /// the first-light order (DSI-1 before DSI-2, else both show noise until a
+    /// restart), so all monitors cycle once — the power key's proven path.
+    pub fn activate_monitor(&mut self, backend: &mut Backend, name: &str) {
+        if !self.dark_outputs.remove(name) {
+            return;
+        }
+        info!("power-on-monitor: {name} wakes (all monitors cycle once)");
+        if self.monitors_active {
+            backend.set_monitors_active(false);
+            backend.set_monitors_active(true);
+        }
+        self.queue_redraw_all();
+    }
+
