+    /// Matrix: clear ONE output's surface (CRTC inactive), like
+    /// `set_monitors_active(false)` does for all. Waking goes through the
+    /// next rendered frame (queue_frame activates the CRTC again).
+    pub fn set_output_active(&mut self, name: &str, active: bool) {
+        if active {
+            return;
+        }
+        for device in self.devices.values_mut() {
+            for surface in device.surfaces.values_mut() {
+                if surface.name.connector == name {
+                    if let Err(err) = surface.compositor.clear() {
+                        warn!("error clearing drm surface {name}: {err:?}");
+                    }
+                }
+            }
+        }
+    }
