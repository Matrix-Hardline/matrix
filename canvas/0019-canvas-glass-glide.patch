@@ -58,6 +58,56 @@ pub struct MappedLayer {
     /// Matrix R126: the appearance pop of solitary glass cards — the
     /// compositor scales body AND content together (island spring).
     pop: Option<Animation>,
+
+    /// Matrix (0019): the glass body gliding to a new place or size.
+    glide: std::cell::RefCell<Glide>,
+}
+
+/// Matrix (0019): where the glass body is drawn while the surface moved.
+/// A client resizes its surface in ONE step (one configure round trip);
+/// the compositor glides the body there in its own frame clock. Before,
+/// the bar stepped five chips every frame and each step waited for a
+/// configure — 13–39 ms a step, visibly jerky on the Duo.
+#[derive(Debug, Default)]
+struct Glide {
+    /// The surface's real rectangle last seen.
+    target: Option<Rectangle<f64, Logical>>,
+    /// The body's rectangle when the current glide began.
+    from: Option<Rectangle<f64, Logical>>,
+    anim: Option<Animation>,
+    /// How melted the body is (0 solitary … 1 fully melted) at the glide's
+    /// start and end: growing a lot melts, shrinking a lot lets go.
+    melt_from: f64,
+    melt_to: f64,
+}
+
+impl Glide {
+    /// The rectangle the body shows now.
+    fn shown(&self) -> Option<Rectangle<f64, Logical>> {
+        let target = self.target?;
+        match (&self.from, &self.anim) {
+            (Some(from), Some(a)) if !a.is_done() => {
+                let t = a.value().clamp(0.0, 1.0);
+                let lerp = |p: f64, q: f64| p + (q - p) * t;
+                Some(Rectangle::new(
+                    Point::from((lerp(from.loc.x, target.loc.x), lerp(from.loc.y, target.loc.y))),
+                    Size::from((lerp(from.size.w, target.size.w), lerp(from.size.h, target.size.h))),
+                ))
+            }
+            _ => Some(target),
+        }
+    }
+
+    /// The melt now (0..1).
+    fn melt(&self) -> f64 {
+        match &self.anim {
+            Some(a) if !a.is_done() => {
+                let t = a.value().clamp(0.0, 1.0);
+                self.melt_from + (self.melt_to - self.melt_from) * t
+            }
+            _ => self.melt_to,
+        }
+    }
 }
 
